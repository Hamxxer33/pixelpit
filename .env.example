# Neon Postgres (required on Vercel — without it the board won't persist)
DATABASE_URL=

# X sign-in ("Connect X") — server only. Never prefix these with VITE_
# OAuth 2.0 Client ID / Secret from the X developer portal, under
# "User authentication settings". These are NOT the API key/secret below.
# Callback URL to register on the X app:
#   https://<your-domain>/api/auth/oauth2/callback/grok-x
# Without them the app tries to sign in through the shared Grok auth broker,
# which only issues callbacks for origins it has a client for — so "Connect X"
# cannot complete on your own domain.
X_CLIENT_ID=
X_CLIENT_SECRET=

# X API — server only. Never prefix these with VITE_
# Consumer keys, used to mint an app bearer for reading public posts.
X_API_KEY=
X_API_SECRET=
# Optional. We mint a bearer from the key + secret if this is empty.
X_BEARER_TOKEN=

# Optional. Extra public hostnames this deployment answers on, comma-separated,
# for domains the platform doesn't advertise via VERCEL_PROJECT_PRODUCTION_URL.
# Sign-in needs the real origin to be trusted, or the request is rejected before
# it ever reaches X.
APP_PUBLIC_HOSTS=
