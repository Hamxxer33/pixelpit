# Neon Postgres (required on Vercel — without it the board won't persist)
DATABASE_URL=

# Login — Privy (https://dashboard.privy.io). Public by design: it identifies
# the app to Privy and is embedded in the browser bundle.
# Exactly 25 characters; anything else disables login (and is logged).
# Privy brokers X sign-in with ITS OWN registered X app, so there is no X
# developer-portal callback to keep in sync with this domain.
VITE_PRIVY_APP_ID=

# X API — server only. Never prefix these with VITE_
# Consumer keys, used to mint an app bearer for READING public posts. Nothing
# to do with login.
X_API_KEY=
X_API_SECRET=
# Optional. We mint a bearer from the key + secret if this is empty.
X_BEARER_TOKEN=

# Optional. The app's own public URL, and extra hostnames it answers on
# (comma-separated). Only used by the legacy Better Auth gate path.
BETTER_AUTH_URL=
APP_PUBLIC_HOSTS=
